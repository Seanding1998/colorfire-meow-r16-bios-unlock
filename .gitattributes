* text=auto eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
# Keep the tested CRLF bytes in Shell scripts, including source archives.
*.nsh -text
# Preserve upstream header hashes and packaged USB checksums byte-for-byte.
/源码/include/** -text -whitespace
/USB_一键工具/** -text whitespace=blank-at-eol,cr-at-eol
*.efi binary
